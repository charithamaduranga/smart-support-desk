# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Team page login (HTTP Basic). Team pages are disabled until TEAM_PASSWORD is set.
TEAM_USERNAME=team
TEAM_PASSWORD=

# AI reply drafts for the team (FAQ-grounded). Drafts are disabled unless both are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: any OpenAI-compatible endpoint (not tested in this project).
# OPENAI_BASE_URL=

# Optional overrides
# Default database: support_desk.db in the project folder (Docker: /data on the app-data volume).
# A relative sqlite:/// path is resolved against the folder you start the app from, so prefer an
# absolute path, e.g. DATABASE_URL=sqlite:////absolute/path/support_desk.db  (4 slashes on Linux/macOS)
# DATABASE_URL=
# HOST=127.0.0.1
# PORT=8000
